# --- Video Creator repository rules (P021) ---
# The packaged Skill needs its own scripts/lib (the Python template above ignores every lib/ folder).
!skills/video-creator/scripts/lib/
skills/**/test-*results.json
# Release archives are attached to GitHub releases, not committed.
release/
.claude/
# experiments: keep notes, scripts and lightweight evidence; drop generated media and machine-specific files.
experiments/**/*.jpg
experiments/**/*.jpeg
experiments/**/*.mp4
experiments/**/*.wav
experiments/**/*.npy
experiments/**/*.png
!experiments/**/*contact*.png
!experiments/**/*sheet*.png
!experiments/**/*overview*.png
!experiments/**/before-after*.png
experiments/**/frames/
experiments/**/setup/*runtime*.json
experiments/**/setup/config.json
experiments/**/setup/capabilities.json
experiments/**/*preview-evidence.json
experiments/**/*measure-evidence.json
experiments/E10/p013.1/test-results.json
experiments/E11/vc-*/project.json
experiments/E13/vc-*/project.json
experiments/E15/p017.7-documentary/qa/preflight-*/preflight.json
experiments/**/*runtime*.json
# --- P025.4 release hygiene ---
# Installed / snapshot copies of the Skill package inside experiment work folders (generated).
experiments/**/installed/
experiments/**/work/after-*/
experiments/**/work/before-*/
experiments/**/work/legacy-*/
experiments/**/work/kit-test/
experiments/**/work/regress/
# Downloaded third-party assets (provenance.json beside them stays tracked).
experiments/**/*.hdr
experiments/**/*.exr
experiments/**/*.bin
experiments/**/*.gltf
experiments/**/*.glb
# Packed topic modules with embedded rendered layers (generated from the tracked *-src.js / hdd-src.js).
experiments/E26/topics/hdd-tech-topic.js
experiments/E26/work/projects/*/topic.js
experiments/E42/projects/*/visual/topic.js
# Logs and stderr captures.
experiments/**/*.err

# --- P026.6C: development experiments are archived out of the active tree (see docs/history/experiments-index.md);
# local copies, media and the archive tarball stay on the maintainer's disk only.
/experiments/
/archive/

# P027.1: local audit notes contain machine paths; keep them local-only.
/docs/audits/
