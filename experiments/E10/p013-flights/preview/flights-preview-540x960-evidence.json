  "captions": [
    {
      "id": 1,
      "start": 0.525,
      "end": 5.025,
      "text": "क्या आपने कभी सोचा है कि एक ही फ्लाइट की टिकट कभी सस्ती,"
    },
    {
      "id": 2,
      "start": 5.025,
      "end": 8.35,
      "text": "तो कभी इतनी महंगी क्यों होती है?"
    },
    {
      "id": 3,
      "start": 8.35,
      "end": 9.05,
      "text": "दरअसल,"
    },
    {
      "id": 4,
      "start": 9.05,
      "end": 12.3,
      "text": "एक विमान को उड़ाने में बहुत खर्च होता है।"
    },
    {
      "id": 5,
      "start": 12.3,
      "end": 16.525,
      "text": "सबसे बड़े खर्चों में से एक है उसका ईंधन।"
    },
    {
      "id": 6,
      "start": 16.525,
      "end": 20.375,
      "text": "इसके अलावा पायलट और बाकी कर्मचारियों की सैलरी,"
    },
    {
      "id": 7,
      "start": 20.375,
      "end": 21.85,
      "text": "विमान की देखभाल,"
    },
    {
      "id": 8,
      "start": 21.85,
      "end": 27.275,
      "text": "उसे किराए पर लेने का खर्च और एयरपोर्ट की फीस भी होती है।"
    },
    {
      "id": 9,
      "start": 27.275,
      "end": 32.575,
      "text": "लेकिन टिकट की कीमत सिर्फ इन खर्चों से तय नहीं होती।"
    },
    {
      "id": 10,
      "start": 32.575,
      "end": 36.125,
      "text": "एयरलाइंस अलग-अलग कीमतों पर सीटें बेचती हैं।"
    },
    {
      "id": 11,
      "start": 36.125,
      "end": 38.925,
      "text": "जैसे-जैसे सस्ती टिकटें बिकती जाती हैं,"
    },
    {
      "id": 12,
      "start": 38.925,
      "end": 42.525,
      "text": "महंगी टिकटें उपलब्ध रह सकती हैं।"
    },
    {
      "id": 13,
      "start": 42.525,
      "end": 46.575,
      "text": "त्योहारों और छुट्टियों में जब यात्रियों की मांग बढ़ती है,"
    },
    {
      "id": 14,
      "start": 46.575,
      "end": 48.65,
      "text": "लेकिन सीटें सीमित होती हैं,"
    },
    {
      "id": 15,
      "start": 48.65,
      "end": 52.125,
      "text": "तो टिकट की कीमत भी बढ़ सकती है।"
    },
    {
      "id": 16,
      "start": 52.125,
      "end": 59.15,
      "text": "इसीलिए एक ही विमान में दो यात्री अलग-अलग कीमत चुकाकर सफर कर सकते हैं।"
    },
    {
      "id": 17,
      "start": 59.15,
      "end": 63.725,
      "text": "यानी फ्लाइट की टिकट की कीमत के पीछे सिर्फ उड़ान का खर्च नहीं,"
    },
    {
      "id": 18,
      "start": 63.725,
      "end": 64.825,
      "text": "बल्कि मांग,"
    },
    {
      "id": 19,
      "start": 64.825,
      "end": 68.8,
      "text": "सीटों की उपलब्धता और बुकिंग का समय भी होता है।"
    }
  ],
