  "style": "tech-explainer",
  "style_reason": "A message's journey is a device-and-network story; the Tech Explainer's dark product studio, glass, beams and isometric cities (P018.3) show phones, a city network and a server hall as one lit world, close to the reference's 3D/X-Ray look.",
  "story": [
    {
      "segment": "s1",
      "role": "hook",
      "idea": "Send 'hi'; it appears in moments. What happens in between?"
    },
    {
      "segment": "s2",
      "role": "mechanism",
      "idea": "The message is locked on your phone; only you and your friend hold the key."
    },
    {
      "segment": "s3",
      "role": "mechanism",
      "idea": "The locked message travels to the server; one grey tick."
    },
    {
      "segment": "s4",
      "role": "contrast",
      "idea": "The server and WhatsApp cannot read it; it only routes it."
    },
    {
      "segment": "s5",
      "role": "example",
      "idea": "If the phone is off it waits, locked, up to 30 days."
    },
    {
      "segment": "s6",
      "role": "mechanism",
      "idea": "Delivered: two grey ticks; removed from the server."
    },
    {
      "segment": "s7",
      "role": "mechanism",
      "idea": "Only the friend's key opens it; read: blue ticks."
    },
    {
      "segment": "s8",
      "role": "resolution",
      "idea": "All of it happens automatically for every message."
    }
  ],
