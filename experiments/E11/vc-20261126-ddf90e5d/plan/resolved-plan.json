  "style": "paper-explainer",
  "style_reason": "Light, colour and air are invisible; cut-paper layers make a physical, touchable world where a white paper beam can literally split into coloured ribbons and scatter into blue paper flecks. The rooftop gives a familiar Indian everyday setting to open and close on.",
  "story": [
    {
      "segment": "s1",
      "role": "hook",
      "idea": "A child on a sunny rooftop looks up: the sky is blue, yet sunlight looks white. Why?"
    },
    {
      "segment": "s2",
      "role": "context",
      "idea": "White sunlight hides all the rainbow colours; a prism reveals them."
    },
    {
      "segment": "s3",
      "role": "mechanism",
      "idea": "Tiny air molecules scatter light every way; short blue waves scatter far more than long red ones."
    },
    {
      "segment": "s4",
      "role": "example",
      "idea": "Scattered blue reaches the eye from the whole sky, so every direction looks blue (back on the rooftop)."
    },
    {
      "segment": "s5",
      "role": "contrast",
      "idea": "Violet scatters even more, but sunlight has less violet and eyes favour blue."
    },
    {
      "segment": "s6",
      "role": "resolution",
      "idea": "At sunset light crosses a long path; blue is scattered away and red-orange arrives: the same rooftop turns orange."
    }
  ],
  "motifs": [
