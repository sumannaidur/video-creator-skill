      "id": "c16",
      "start": 50.575,
      "end": 52.125
    },
    {
      "start_sample": 1251000,
      "speech_end_sample": 1342200,
      "text": "तो रोशनी को हवा में लंबा रास्ता तय करना पड़ता है।",
      "text_ref": {
        "field": "speech",
