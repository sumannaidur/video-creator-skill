      "start": 0.625,
      "end": 2.075
    },
    {
      "start_sample": 49800,
      "speech_end_sample": 95400,
      "text": "आसमान नीला क्यों दिखता है,",
      "text_ref": {
        "field": "speech",
        "start": 16,
        "end": 42
      },
      "segment": "s1",
      "timing_sources": [
        "native_model"
      ],
      "long": false,
      "end_sample": 99000,
      "id": "c2",
      "start": 2.075,
      "end": 4.125
    },
    {
      "start_sample": 99000,
      "speech_end_sample": 172800,
      "text": "जबकि सूरज की रोशनी तो सफ़ेद लगती है?",
      "text_ref": {
        "field": "speech",
        "start": 43,
        "end": 79
      },
      "segment": "s1",
      "timing_sources": [
        "native_model"
      ],
      "long": false,
      "end_sample": 189600,
      "id": "c3",
      "start": 4.125,
      "end": 7.9
    },
    {
      "start_sample": 193200,
      "speech_end_sample": 306600,
      "text": "असल में इस सफ़ेद रोशनी में इंद्रधनुष के सारे रंग छिपे हैं।",
      "text_ref": {
        "field": "speech",
        "start": 80,
        "end": 138
      },
      "segment": "s2",
      "timing_sources": [
        "native_model"
      ],
      "long": false,
      "end_sample": 308400,
      "id": "c4",
      "start": 8.05,
      "end": 12.85
    },
    {
      "start_sample": 308400,
      "speech_end_sample": 399600,
      "text": "प्रिज़्म से गुज़रते ही वे अलग-अलग दिखने लगते हैं।",
      "text_ref": {
        "field": "speech",
        "start": 139,
        "end": 188
      },
      "segment": "s2",
      "timing_sources": [
        "native_model"
      ],
      "long": false,
      "end_sample": 416400,
      "id": "c5",
      "start": 12.85,
      "end": 17.35
    },
    {
      "start_sample": 419400,
      "speech_end_sample": 477000,
      "text": "यह रोशनी जब हवा से टकराती है,",
      "text_ref": {
        "field": "speech",
        "start": 189,
        "end": 218
      },
      "segment": "s3",
      "timing_sources": [
        "native_model"
      ],
      "long": false,
      "end_sample": 479400,
      "id": "c6",
      "start": 17.475,
      "end": 19.975
    },
    {
      "start_sample": 479400,
      "speech_end_sample": 570000,
      "text": "तो हवा के नन्हे अणु उसे चारों तरफ़ बिखेर देते हैं।",
      "text_ref": {
        "field": "speech",
        "start": 219,
        "end": 269
      },
      "segment": "s3",
      "timing_sources": [
        "native_model"
      ],
      "long": false,
      "end_sample": 572400,
      "id": "c7",
      "start": 19.975,
      "end": 23.85
    },
    {
      "start_sample": 572400,
      "speech_end_sample": 631200,
      "text": "नीला रंग छोटी तरंगों में चलता है,",
      "text_ref": {
        "field": "speech",
        "start": 270,
        "end": 303
      },
      "segment": "s3",
      "timing_sources": [
        "native_model"
      ],
      "long": false,
      "end_sample": 634200,
      "id": "c8",
      "start": 23.85,
      "end": 26.425
    },
    {
      "start_sample": 634200,
      "speech_end_sample": 707400,
      "text": "इसलिए वह लाल से कहीं ज़्यादा बिखरता है।",
      "text_ref": {
        "field": "speech",
        "start": 304,
        "end": 343
      },
      "segment": "s3",
      "timing_sources": [
        "native_model"
      ],
      "long": false,
      "end_sample": 724200,
      "id": "c9",
      "start": 26.425,
      "end": 30.175
    },
    {
      "start_sample": 727200,
      "speech_end_sample": 847200,
      "text": "यही बिखरी नीली रोशनी पूरे आसमान से हमारी आँखों तक आती है,",
      "text_ref": {
        "field": "speech",
        "start": 344,
        "end": 401
      },
      "segment": "s4",
      "timing_sources": [
        "native_model"
      ],
      "long": false,
      "end_sample": 850200,
      "id": "c10",
      "start": 30.3,
      "end": 35.425
    },
    {
      "start_sample": 850200,
      "speech_end_sample": 923400,
      "text": "इसलिए हर तरफ़ आसमान नीला दिखता है।",
      "text_ref": {
        "field": "speech",
        "start": 402,
        "end": 436
      },
      "segment": "s4",
      "timing_sources": [
        "native_model"
      ],
      "long": false,
      "end_sample": 940200,
      "id": "c11",
      "start": 35.425,
      "end": 39.175
    },
    {
      "start_sample": 943200,
      "speech_end_sample": 1002600,
      "text": "बैंगनी तो और भी ज़्यादा बिखरता है,",
      "text_ref": {
        "field": "speech",
        "start": 437,
        "end": 471
      },
      "segment": "s5",
      "timing_sources": [
        "native_model"
      ],
      "long": false,
      "end_sample": 1005000,
      "id": "c12",
      "start": 39.3,
      "end": 41.875
    },
    {
      "start_sample": 1005000,
      "speech_end_sample": 1056600,
      "text": "पर धूप में बैंगनी कम होता है,",
      "text_ref": {
        "field": "speech",
        "start": 472,
        "end": 501
      },
      "segment": "s5",
      "timing_sources": [
        "native_model"
      ],
      "long": false,
