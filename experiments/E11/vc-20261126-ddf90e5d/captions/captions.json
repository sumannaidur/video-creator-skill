      "id": "c13",
      "start": 41.875,
      "end": 44.175
    },
    {
      "start_sample": 1060200,
      "speech_end_sample": 1169400,
      "text": "और हमारी आँखें नीले को ज़्यादा आसानी से पहचानती हैं।",
      "text_ref": {
        "field": "speech",
        "start": 502,
        "end": 554
      },
      "segment": "s5",
      "timing_sources": [
        "native_model"
      ],
