  "phrases": [
    {
      "start": 0.625,
      "end": 1.975,
      "text": "ज़रा ऊपर देखिए।"
    },
    {
      "start": 2.075,
      "end": 3.975,
      "text": "आसमान नीला क्यों दिखता है,"
    },
    {
      "start": 4.125,
      "end": 7.2,
      "text": "जबकि सूरज की रोशनी तो सफ़ेद लगती है?"
    },
    {
      "start": 8.05,
      "end": 12.775,
      "text": "असल में इस सफ़ेद रोशनी में इंद्रधनुष के सारे रंग छिपे हैं।"
    },
    {
      "start": 12.85,
      "end": 16.65,
      "text": "प्रिज़्म से गुज़रते ही वे अलग-अलग दिखने लगते हैं।"
    },
    {
      "start": 17.475,
      "end": 19.875,
      "text": "यह रोशनी जब हवा से टकराती है,"
    },
    {
      "start": 19.975,
      "end": 23.75,
      "text": "तो हवा के नन्हे अणु उसे चारों तरफ़ बिखेर देते हैं।"
    },
    {
      "start": 23.85,
      "end": 26.3,
      "text": "नीला रंग छोटी तरंगों में चलता है,"
    },
    {
      "start": 26.425,
      "end": 29.475,
      "text": "इसलिए वह लाल से कहीं ज़्यादा बिखरता है।"
    },
    {
      "start": 30.3,
      "end": 35.3,
      "text": "यही बिखरी नीली रोशनी पूरे आसमान से हमारी आँखों तक आती है,"
    },
    {
      "start": 35.425,
      "end": 38.475,
      "text": "इसलिए हर तरफ़ आसमान नीला दिखता है।"
    },
    {
      "start": 39.3,
      "end": 41.775,
      "text": "बैंगनी तो और भी ज़्यादा बिखरता है,"
    },
    {
      "start": 41.875,
      "end": 44.025,
      "text": "पर धूप में बैंगनी कम होता है,"
    },
    {
      "start": 44.175,
      "end": 48.725,
      "text": "और हमारी आँखें नीले को ज़्यादा आसानी से पहचानती हैं।"
    },
    {
      "start": 49.525,
      "end": 50.4,
      "text": "और शाम को?"
    },
    {
      "start": 50.575,
      "end": 52.025,
      "text": "सूरज नीचे होता है,"
    },
    {
      "start": 52.125,
      "end": 55.925,
      "text": "तो रोशनी को हवा में लंबा रास्ता तय करना पड़ता है।"
    },
    {
      "start": 56.05,
      "end": 58.175,
      "text": "नीला रास्ते में ही बिखर जाता है,"
    },
    {
      "start": 58.325,
      "end": 61.25,
      "text": "और लाल-नारंगी रंग हम तक पहुँचते हैं।"
    }
  ],
