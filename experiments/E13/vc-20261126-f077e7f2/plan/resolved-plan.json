  },
  "style": "paper-explainer",
  "style_reason": "Wheels, rails, sleepers and ballast are physical, layered objects; a cut-paper diorama lets the viewer see a train from impossible angles (under the coach, along the axle, from above the bend) while staying warm and tactile. Exaggerated paper cones make an invisible, slight taper visible.",
  "story": [
    {
      "segment": "s1",
      "role": "hook",
      "idea": "A heavy train swings round a hillside bend with no steering wheel; a girl at the fence wonders why it does not slide off."
    },
    {
      "segment": "s2",
      "role": "context",
      "idea": "Most people credit the inner rim (flange); the real secret is the wheel shape."
    },
    {
      "segment": "s3",
      "role": "mechanism",
      "idea": "Two wheels are fixed on one rigid axle and always turn together."
    },
    {
      "segment": "s4",
      "role": "mechanism",
      "idea": "Each tread is slightly coned like an ice-cream cone: fat on the inside, thin on the outside."
    },
    {
      "segment": "s5",
      "role": "example",
      "idea": "If the wheelset drifts sideways, the slope brings it back to the middle by itself."
    },
    {
      "segment": "s6",
      "role": "mechanism",
      "idea": "On a bend the set shifts outward; the outer wheel rides its fat part and covers more distance per turn."
    },
    {
      "segment": "s7",
      "role": "contrast",
      "idea": "The inner wheel rides its thin part and covers less; so the train follows the bend without slipping."
    },
    {
      "segment": "s8",
      "role": "resolution",
      "idea": "The flange is the last line of defence against strong pushes like crosswinds; the real work is done by the small slope."
    }
  ],
  "motifs": [
    {
      "id": "m-cone",
      "stands_for": "the coned tread (an ice-cream cone; fat inside, thin outside)"
    },
    {
      "id": "m-flange",
      "stands_for": "the flange, the backup rim (marked in terracotta)"
    },
    {
      "id": "m-tape",
      "stands_for": "distance travelled per wheel turn (paper measuring tape: orange long, blue short)"
    },
    {
      "id": "m-girl",
      "stands_for": "the viewer's curiosity; opens with the question and closes with the answer"
    },
    {
      "id": "m-centre",
      "stands_for": "the middle of the track (a chalk centre mark)"
    }
  ],
