      "start": 5.725,
      "end": 8.825
    },
    {
      "start_sample": 211800,
      "speech_end_sample": 242400,
      "text": "చాలామంది అనుకుంటారు,",
      "text_ref": {
        "field": "speech",
        "start": 116,
        "end": 136
