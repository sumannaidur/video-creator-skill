      "end_sample": 328800,
      "id": "c5",
      "start": 10.55,
      "end": 13.7
    },
    {
      "start_sample": 328800,
      "speech_end_sample": 395400,
      "text": "కానీ అసలు రహస్యం చక్రం ఆకారంలో ఉంది.",
      "text_ref": {
        "field": "speech",
