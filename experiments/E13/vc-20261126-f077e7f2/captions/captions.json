      "start": 3.225,
      "end": 5.725
    },
    {
      "start_sample": 137400,
      "speech_end_sample": 204000,
      "text": "మరి పట్టాల మీద నుంచి ఎందుకు జారిపోదు?",
      "text_ref": {
