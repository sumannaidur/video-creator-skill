      "id": "c4",
      "start": 8.825,
      "end": 10.55
    },
    {
      "start_sample": 253200,
      "speech_end_sample": 316800,
      "text": "చక్రం లోపలి అంచే రైలును పట్టుకుంటుందని.",
      "text_ref": {
        "field": "speech",
