  "captions": [
    {
      "id": 1,
      "cue": "c1",
      "start": 0.05,
      "end": 3.225,
      "text": "ఎంతో బరువున్న రైలు వేగంగా వంపు తిరుగుతుంది."
    },
    {
      "id": 2,
      "cue": "c2",
      "start": 3.225,
      "end": 5.725,
      "text": "దానికి స్టీరింగ్ చక్రం కూడా లేదు."
    },
    {
      "id": 3,
      "cue": "c3",
      "start": 5.725,
      "end": 8.825,
      "text": "మరి పట్టాల మీద నుంచి ఎందుకు జారిపోదు?"
    },
    {
      "id": 4,
      "cue": "c4",
      "start": 8.825,
      "end": 10.55,
      "text": "చాలామంది అనుకుంటారు,"
    },
    {
      "id": 5,
      "cue": "c5",
      "start": 10.55,
      "end": 13.7,
      "text": "చక్రం లోపలి అంచే రైలును పట్టుకుంటుందని."
    },
    {
      "id": 6,
      "cue": "c6",
      "start": 13.7,
      "end": 16.8,
      "text": "కానీ అసలు రహస్యం చక్రం ఆకారంలో ఉంది."
    },
    {
      "id": 7,
      "cue": "c7",
      "start": 16.8,
      "end": 20.3,
      "text": "రెండు చక్రాలూ ఒకే గట్టి ఇరుసుకు బిగించి ఉంటాయి."
    },
    {
      "id": 8,
      "cue": "c8",
      "start": 20.3,
      "end": 22.975,
      "text": "అందుకే అవి ఎప్పుడూ కలిసే తిరుగుతాయి."
    },
    {
      "id": 9,
      "cue": "c9",
      "start": 22.975,
      "end": 23.75,
      "text": "ఇంకా,"
    },
    {
      "id": 10,
      "cue": "c10",
      "start": 23.75,
      "end": 27.55,
      "text": "ప్రతి చక్రం ఐస్‌క్రీమ్ కోన్‌లా కొంచెం వాలుగా ఉంటుంది."
    },
    {
      "id": 11,
      "cue": "c11",
      "start": 27.55,
      "end": 29.225,
      "text": "లోపలి వైపు లావుగా,"
    },
    {
      "id": 12,
      "cue": "c12",
      "start": 29.225,
      "end": 30.675,
      "text": "బయటి వైపు సన్నగా."
    },
    {
      "id": 13,
      "cue": "c13",
      "start": 30.675,
      "end": 33.125,
      "text": "రైలు కాస్త ఒక పక్కకు జరిగితే,"
    },
    {
      "id": 14,
      "cue": "c14",
      "start": 33.125,
      "end": 36.2,
      "text": "ఈ వాలే దాన్ని మళ్లీ మధ్యలోకి తెస్తుంది."
    },
    {
      "id": 15,
      "cue": "c15",
      "start": 36.2,
      "end": 38.225,
      "text": "తనంతట తానే సర్దుకుంటుంది."
    },
    {
      "id": 16,
      "cue": "c16",
      "start": 38.225,
      "end": 41.45,
      "text": "వంపులో రైలు బయటి పట్టా వైపు జరుగుతుంది."
    },
    {
      "id": 17,
      "cue": "c17",
      "start": 41.45,
      "end": 44.925,
      "text": "అప్పుడు బయటి చక్రం లావైన భాగం మీద తిరిగి,"
    },
    {
      "id": 18,
      "cue": "c18",
      "start": 44.925,
      "end": 47.35,
      "text": "ఒక్క చుట్టుకే ఎక్కువ దూరం వెళ్తుంది."
    },
    {
      "id": 19,
      "cue": "c19",
      "start": 47.35,
      "end": 51.45,
      "text": "లోపలి చక్రం సన్నని భాగం మీద తక్కువ దూరం వెళ్తుంది."
    },
    {
      "id": 20,
      "cue": "c20",
      "start": 51.45,
      "end": 54.9,
      "text": "అలా జారకుండానే రైలు వంపును అనుసరిస్తుంది."
    },
    {
      "id": 21,
      "cue": "c21",
      "start": 54.9,
      "end": 56.475,
      "text": "మరి అంచు ఎందుకు?"
    },
    {
      "id": 22,
      "cue": "c22",
      "start": 56.475,
      "end": 59.325,
      "text": "గట్టి గాలి లాంటి బలమైన తోపుడు వస్తే,"
    },
    {
      "id": 23,
      "cue": "c23",
      "start": 59.325,
      "end": 60.95,
      "text": "అదే చివరి రక్షణ."
    },
    {
      "id": 24,
      "cue": "c24",
      "start": 60.95,
      "end": 63.675,
      "text": "కానీ అసలు పని మాత్రం ఈ చిన్న వాలుదే!"
    }
  ],
