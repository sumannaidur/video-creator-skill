  "phrases": [
    {
      "start": 0.05,
      "end": 1.625,
      "text": "విశ్రాంతిగా ఉన్నప్పుడు కూడా,"
    },
    {
      "start": 1.975,
      "end": 5.725,
      "text": "మీ గుండె నిమిషానికి అరవై నుంచి వంద సార్లు కొట్టుకుంటుంది."
    },
    {
      "start": 6.325,
      "end": 7.875,
      "text": "ఒక్క క్షణం కూడా ఆగకుండా."
    },
    {
      "start": 8.3,
      "end": 10.325,
      "text": "మరి అది రక్తాన్ని ఎలా పంపుతుంది?"
    },
    {
      "start": 10.65,
      "end": 12.575,
      "text": "గుండెలో నాలుగు గదులు ఉంటాయి."
    },
    {
      "start": 12.975,
      "end": 14.25,
      "text": "పైన రెండు కర్ణికలు,"
    },
    {
      "start": 14.625,
      "end": 16.075,
      "text": "కింద రెండు జఠరికలు."
    },
    {
      "start": 16.4,
      "end": 21.35,
      "text": "శరీరం నుంచి వచ్చే ఆక్సిజన్ తక్కువ ఉన్న రక్తం కుడి కర్ణికలోకి చేరుతుంది."
    },
    {
      "start": 21.95,
      "end": 24.925,
      "text": "కుడి జఠరిక దాన్ని ఊపిరితిత్తులకు పంపుతుంది."
    },
    {
      "start": 25.25,
      "end": 28.075,
      "text": "ఊపిరితిత్తుల్లో ఆ రక్తం ఆక్సిజన్ నింపుకొని,"
    },
    {
      "start": 28.475,
      "end": 30.35,
      "text": "ఎడమ కర్ణికలోకి తిరిగి వస్తుంది."
    },
    {
      "start": 30.925,
      "end": 33.4,
      "text": "అక్కడి నుంచి ఎడమ జఠరికలోకి దిగుతుంది."
    },
    {
      "start": 33.725,
      "end": 36.05,
      "text": "ఎడమ జఠరిక బలంగా ఒత్తిడి పెంచి,"
    },
    {
      "start": 36.475,
      "end": 39.075,
      "text": "ఆ రక్తాన్ని తల నుంచి కాలి వేళ్ల దాకా,"
    },
    {
      "start": 39.45,
      "end": 40.875,
      "text": "శరీరమంతటికీ నెడుతుంది."
    },
    {
      "start": 41.2,
      "end": 44.6,
      "text": "నాలుగు కవాటాలు తలుపుల్లా ఒకే వైపు తెరుచుకుంటాయి."
    },
    {
      "start": 45.1,
      "end": 46.9,
      "text": "రక్తం వెనక్కి రాకుండా ఆపుతాయి."
    },
    {
      "start": 47.225,
      "end": 50.425,
      "text": "అవి మూసుకునే శబ్దమే మనకు వినిపించే లబ్ డబ్."
    },
    {
      "start": 50.75,
      "end": 55.05,
      "text": "ఇదంతా కుడి కర్ణికలోని ఒక చిన్న విద్యుత్ సంకేతంతో మొదలవుతుంది."
    },
    {
      "start": 55.475,
      "end": 56.2,
      "text": "ప్రతి క్షణం,"
    },
    {
      "start": 56.625,
      "end": 57.725,
      "text": "మీకు తెలియకుండానే."
    }
