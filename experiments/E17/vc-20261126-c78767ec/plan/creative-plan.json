  "style": "paper-explainer",
  "style_reason": "A heart is a layered physical organ; cut-paper construction lets one consistent paper heart open, be travelled through and be re-lit shot after shot, matching the Painted Story / Paper Collage reference language with full-bleed scenes.",
  "story": [
    {
      "segment": "s1",
      "role": "hook",
      "idea": "Even at rest the heart beats 60–100 times a minute; how does it pump?"
    },
    {
      "segment": "s2",
      "role": "context",
      "idea": "Four chambers: two atria above, two ventricles below."
    },
    {
      "segment": "s3",
      "role": "mechanism",
      "idea": "Right side: body blood in, pumped to the lungs."
    },
    {
      "segment": "s4",
      "role": "mechanism",
      "idea": "Lungs add oxygen; blood returns to the left atrium and ventricle."
    },
    {
      "segment": "s5",
      "role": "mechanism",
      "idea": "The left ventricle drives blood to the whole body."
    },
    {
      "segment": "s6",
      "role": "mechanism",
      "idea": "Valves open one way and stop backflow."
    },
    {
      "segment": "s7",
      "role": "example",
      "idea": "Closing valves make the lub-dub sound."
    },
    {
      "segment": "s8",
      "role": "resolution",
      "idea": "An electrical signal from the right atrium starts every beat."
    }
  ],
  "motifs": [
    {
      "id": "m-cells",
      "stands_for": "blood cells travelling the loop (blue: oxygen-poor, red: oxygen-rich — teaching colours)"
    },
    {
