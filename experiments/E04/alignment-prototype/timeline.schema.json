{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Narration timeline v1",
  "type": "object",
  "required": ["version", "unit", "locale", "validation", "audio", "text", "records"],
  "properties": {
    "version": {"const": 1},
    "unit": {"const": "sample"},
    "locale": {"type": "string", "minLength": 1},
    "validation": {"enum": ["unreviewed", "reviewed"]},
    "audio": {
      "type": "object",
      "required": ["path", "sha256", "sample_rate", "sample_count"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sample_rate": {"type": "integer", "minimum": 1},
        "sample_count": {"type": "integer", "minimum": 1}
      }
    },
    "text": {
      "type": "object",
      "required": ["display", "speech"],
      "properties": {
        "display": {"type": "string", "minLength": 1},
        "speech": {"type": "string", "minLength": 1}
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "label", "source", "start", "end"],
        "properties": {
          "kind": {"enum": ["sentence", "phrase", "word", "phoneme", "pause"]},
          "label": {"type": "string", "minLength": 1},
          "source": {"enum": ["native_model", "forced_alignment", "audio_boundary", "manual", "estimated", null]},
          "start": {"type": ["integer", "null"], "minimum": 0},
          "end": {"type": ["integer", "null"], "minimum": 0},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "text_ref": {
            "type": "object",
            "required": ["field", "start", "end"],
            "properties": {
              "field": {"enum": ["display", "speech"]},
              "start": {"type": "integer", "minimum": 0},
              "end": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
